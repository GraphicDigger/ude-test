{
  "version": "0.1.0",
  "projectRoot": ".",
  "fileRoles": {},
  "themeContext": {
    "importSpec": {
      "source": "@/shared/theme/model/context/context",
      "name": "ThemeContext"
    },
    "defaultVarName": "theme",
    "source": {
      "kind": "css-vars",
      "file": "src/shared/theme/tokens.css"
    },
    "modeGroups": [
      {
        "id": "theme",
        "isGlobal": true,
        "modes": [
          {
            "id": "light",
            "selector": ":root",
            "label": "light"
          },
          {
            "id": "dark",
            "selector": "[data-theme='dark']",
            "label": "dark"
          }
        ],
        "defaultMode": "light",
        "type": "theme"
      },
      {
        "id": "breakpoint",
        "isGlobal": true,
        "modes": [
          {
            "id": "desktop",
            "selector": ":root",
            "label": "desktop"
          },
          {
            "id": "tablet",
            "selector": "@media (max-width: 1023px)",
            "label": "tablet"
          },
          {
            "id": "phone",
            "selector": "@media (max-width: 640px)",
            "label": "phone"
          }
        ],
        "defaultMode": "desktop",
        "type": "breakpoint"
      }
    ],
    "collectionRules": [
      {
        "prefix": "--ref-color-",
        "collectionName": "ref-colors",
        "kind": "tokens"
      },
      {
        "prefix": "--sys-",
        "collectionName": "sys",
        "kind": "tokens"
      },
      {
        "prefix": "--typo-",
        "collectionName": "typography",
        "kind": "presets",
        "multiField": true,
        "domain": "typography"
      }
    ]
  },
  "parsingRules": {
    "autoLoad": [
      "src/shared/theme/tokens.css"
    ],
    "exclude": [],
    "priority": [
      "src/shared/theme/tokens.css"
    ]
  },
  "codegenRules": {
    "formatting": "prettier",
    "importStyle": "named"
  },
  "dependencies": {
    "graph": false,
    "autoUpdate": false
  },
  "sourceCode": {
    "mode": "remote-git",
    "remoteRepoUrl": "https://github.com/GraphicDigger/ude-test"
  },
  "codeEditor": {
    "editor": "monaco"
  },
  "platform": "web",
  "database": {
    "recordsDir": "src/data/"
  },
  "navigation": {
    "form": "react-router",
    "routesPath": "src/routes.tsx"
  },
  "dataFileRoles": {}
}

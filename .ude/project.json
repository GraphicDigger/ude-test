{
  "version": "0.1.0",
  "projectRoot": ".",
  "fileRoles": {},
  "dataFileRoles": {},
  "themeContext": {
    "importSpec": {
      "source": "@/shared/theme/model/context/context",
      "name": "ThemeContext"
    },
    "defaultVarName": "theme",
    "source": { "kind": "css-vars", "file": "src/shared/theme/tokens.css" },
    "modeGroups": [
      {
        "id": "theme",
        "type": "theme",
        "isGlobal": true,
        "defaultMode": "light",
        "modes": [
          { "id": "light", "label": "light", "selector": ":root" },
          { "id": "dark", "label": "dark", "selector": "[data-theme='dark']" }
        ]
      },
      {
        "id": "breakpoint",
        "type": "breakpoint",
        "isGlobal": true,
        "defaultMode": "desktop",
        "modes": [
          { "id": "desktop", "label": "desktop", "selector": ":root" },
          { "id": "tablet", "label": "tablet", "selector": "@media (max-width: 1023px)" },
          { "id": "phone", "label": "phone", "selector": "@media (max-width: 640px)" }
        ]
      }
    ],
    "collectionRules": [
      { "prefix": "--ref-color-", "collectionName": "ref-colors", "kind": "tokens" },
      { "prefix": "--sys-", "collectionName": "sys", "kind": "tokens" },
      {
        "prefix": "--typo-",
        "collectionName": "typography",
        "kind": "presets",
        "multiField": true,
        "domain": "typography"
      }
    ]
  },
  "parsingRules": {
    "autoLoad": ["src/shared/theme/tokens.css"],
    "exclude": [],
    "priority": ["src/shared/theme/tokens.css"]
  },
  "database": {
    "recordsDir": "src/data/"
  }
}
